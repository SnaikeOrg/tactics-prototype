{
  "name": "tactics-prototype",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @tactics/web dev",
